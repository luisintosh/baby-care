# Create a Supabase project, run the files in supabase/migrations in the SQL editor
# (or `supabase db push`), then paste the project URL and anon (publishable) key here.
#
# Comida alerts use Web Push. Generate a key pair with:
#   npx web-push generate-vapid-keys
# Put the public key here and in the GitHub Actions secret VITE_VAPID_PUBLIC_KEY.
#
# Function secrets (not committed):
#   supabase secrets set VAPID_PUBLIC_KEY=... VAPID_PRIVATE_KEY=... VAPID_SUBJECT=mailto:you@example.com CRON_SECRET=...
# VAPID_SUBJECT is a mailto: contact. CRON_SECRET is any long random string.
# Use the same public key for VITE_VAPID_PUBLIC_KEY and VAPID_PUBLIC_KEY.
#
# Vault, in the SQL editor, so the every-5-minute cron can call the function:
#   select vault.create_secret('https://YOUR_PROJECT.supabase.co', 'project_url');
#   select vault.create_secret('the-same-CRON_SECRET', 'cron_secret');
# Then deploy: supabase functions deploy feed-reminder
#
# On iPhone, add Baby to the Home Screen or the avisos toggle stays disabled.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key
VITE_VAPID_PUBLIC_KEY=
